---
const links = [
  { href: '/', label: 'home' },
  { href: '/learn', label: 'learn' },
  { href: '/events', label: 'events' },
  { href: '/resources', label: 'resources' },
  { href: '/tools', label: 'tools' },
  { href: '/contribute', label: 'contribute' },
];
const path = Astro.url.pathname;
---
<header class="mq-topbar">
  <a href="/" class="mq-logo">
    <span class="mq-logo__mark">{'{}'}</span>
    <span class="mq-logo__text">
      <span class="mq-logo__name">MQ Competitive Programming Club</span>
      <span class="mq-logo__sub">acm.icpc · macquarie</span>
    </span>
  </a>

  <span class="mq-topbar__spacer"></span>

  <button class="ps-btn ps-btn--sm w-[34px] h-[34px] p-0 rounded-md" data-theme-toggle title="Toggle theme">
    <span class="text-[15px]">◐</span>
  </button>

  {/* Sign-in with GitHub is hidden until auth is supported — keep the markup for later.
  <button class="ps-btn ps-btn--primary whitespace-nowrap" disabled title="Coming soon">Sign in with GitHub</button>
  */}
</header>

<nav class="mq-nav">
  <div class="mq-nav__inner">
    {links.map((l) => (
      <a class="mq-navlink" href={l.href} data-active={path === l.href}>{l.label}</a>
    ))}
  </div>
</nav>
