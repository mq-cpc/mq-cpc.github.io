---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';

const tools: { name: string; blurb: string; app?: string; url?: string; soon?: boolean }[] = [
  {
    name: 'Graph Visualiser',
    blurb: 'Sketch graphs on a dot-grid whiteboard — add nodes, connect weighted edges, rename and rearrange, all from the keyboard or a right-click menu.',
    app: '/tools/graph/',
  },
];
---
<Base title="Tools — MQ CP Club">
  <Header />
  <main class="mq-page">
    <div class="mono mq-eyebrow">// TOOLS</div>
    <h1 class="ps-h1 mq-h1-gap">Tools built by members.</h1>
    <p class="text-ink max-w-measure">Small client-side utilities we use in workshops and while practising.</p>
    <div class="mq-grid-3 mt-6">
      {tools.map((t) => (
        <div class="ps-card ps-card--accent">
          <div class="flex justify-between items-center">
            <div class="ps-card__title">{t.name}</div>
            {t.soon && <span class="ps-pill">soon</span>}
          </div>
          <div class="ps-card__body">{t.blurb}</div>
          {t.app
            ? <a class="mono mq-link mq-link--card" href={t.app}>open tool →</a>
            : t.url
              ? <a class="mono mq-link mq-link--card" href={t.url} target="_blank" rel="noopener">open repo →</a>
              : <span class="mono text-label text-ink-muted mt-auto">coming soon</span>}
        </div>
      ))}
    </div>
  </main>
</Base>
