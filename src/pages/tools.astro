---
import { withBase } from '../lib/base';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';

const tools: { name: string; blurb: string; app?: string; url?: string; soon?: boolean }[] = [
  {
    name: 'Graph Visualiser',
    blurb: 'Sketch graphs on a dot-grid whiteboard — add nodes, connect weighted edges, rename and rearrange, all from the keyboard or a right-click menu.',
    app: '/tools/graph/',
  },
];
---
<Base title="Tools — MQ CP Club" description="Small browser-based utilities built by MQ Competitive Programming Club members, for use while practising.">
  <Header />
  <main class="mq-page">
    <div class="mono mq-eyebrow">// TOOLS</div>
    <h1 class="ps-h1 mq-h1-gap">Tools for teaching and learning</h1>
    <p class="text-ink max-w-measure">
      The page will contain tools that we find useful for learning algorithms.
      More will be added in the future.
    </p>

    {/* A row list rather than a card grid: with one tool a grid leaves a single
        card stranded in an otherwise empty track, and rows read the same at one
        item or at ten. */}
    <ul class="mq-tools">
      {tools.map((t) => (
        <li class="mq-tool">
          <div class="mq-tool__text">
            <h2 class="mq-tool__name">
              {t.name}
              {t.soon && <span class="ps-pill">soon</span>}
            </h2>
            <p class="mq-tool__blurb">{t.blurb}</p>
          </div>
          {t.app ? (
            <a class="ps-btn ps-btn--primary" href={withBase(t.app)}>Open tool →</a>
          ) : t.url ? (
            <a class="ps-btn" href={t.url} target="_blank" rel="noopener">View repo →</a>
          ) : (
            <span class="mono text-label text-ink-muted">coming soon</span>
          )}
        </li>
      ))}
    </ul>

    <p class="text-ink max-w-measure mt-6">
      {tools.length === 1
        ? 'One tool so far.'
        : `${tools.length} tools so far.`}
      {' '}Built something you use while practising? It can live here —
      <a class="mono text-accent-text no-underline" href={withBase("/contribute")}>how to contribute →</a>
    </p>
  </main>
</Base>
