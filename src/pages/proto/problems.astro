---
// PROTOTYPE — not linked from the nav, safe to delete.
// Explores the problem-first accordion with tag filtering, using the real
// Java Basics problems and the proposed video/tag pairing. No schema change
// and no content migration: the pairing lives in the const below.
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import { getCollection, render } from 'astro:content';

const PAIRING: Record<string, { tag: string; video?: { title: string; id: string; dur: string } }> = {
  reversebinary: { tag: 'bit manipulation', video: { title: 'Bit Manipulation', id: '-mei7QTS69s', dur: '26:00' } },
  heimavinna:    { tag: 'strings',          video: { title: 'String Splitting', id: 'ytLOqxitrdY', dur: '11:41' } },
  everywhere:    { tag: 'collections',      video: { title: 'HashSet', id: '3oExWCR2SEA', dur: '20:04' } },
  t9spelling:    { tag: 'collections',      video: { title: 'HashMap', id: 'f6hagLrbvkY', dur: '22:45' } },
  filip:         { tag: 'strings',          video: { title: 'StringBuilder', id: 'ncQPYq-shwo', dur: '13:38' } },
  keytocrypto:   { tag: 'strings',          video: { title: 'ASCII', id: 'v0Bri70Akdg', dur: '21:09' } },
  sortofsorting: { tag: 'sorting',          video: { title: 'Sorting an ArrayList', id: 'WZnb4XrK-ao', dur: '20:14' } },
  warehouse:     { tag: 'collections',      video: { title: 'Traversing a Map', id: '3GkNUWuVxPs', dur: '28:32' } },
  sort:          { tag: 'collections',      video: { title: 'Map.Entry and var', id: '28Esy94bXzk', dur: '14:50' } },
  iwannabe:      { tag: 'classes',          video: { title: 'Using Classes', id: 'jz9Cqd4Po7E', dur: '12:45' } },
};

// Fixed order so a tag keeps the same hue between visits.
const TAG_ORDER = ['input/output', 'strings', 'bit manipulation', 'collections', 'sorting', 'classes'];
const hueOf = (tag: string) => `var(--cat-${(TAG_ORDER.indexOf(tag) % 6) + 1})`;

const all = await getCollection('problems');
const rows = await Promise.all(
  all
    .filter((p) => PAIRING[p.id])
    .sort((a, b) => a.data.order - b.data.order)
    .map(async (p) => ({
      slug: p.id,
      title: p.data.title,
      difficulty: p.data.difficulty,
      url: p.data.url,
      judge: p.data.judge,
      ...PAIRING[p.id],
      // The Kattis problem id is the last URL segment, and it is exactly the
      // argument kattis-cli needs — the same one the hero terminal submits.
      kid: p.data.url.replace(/\/+$/, '').split('/').pop(),
      Body: p.body && p.body.trim() ? (await render(p)).Content : null,
    })),
);

const counts = TAG_ORDER.map((t) => ({ tag: t, n: rows.filter((r) => r.tag === t).length })).filter((c) => c.n > 0);
const diffColor: Record<string, string> = { easy: 'var(--success)', medium: 'var(--warning)', hard: 'var(--danger)' };
const pad = (n: number) => String(n).padStart(2, '0');
---
<Base title="Prototype — problem list" description="Prototype of the problem-first accordion with tag filtering.">
  <Header />
  <main class="mq-page">
    <div class="mono mq-eyebrow">// PROTOTYPE</div>
    <h1 class="ps-h1 mq-h1-gap">Java Basics — problems</h1>
    <p class="text-ink max-w-measure mt-3">
      One list instead of two. Each row carries the concept tag so you can tell what a problem is
      about before opening it; opening it gives the notes, the video, and the judge link together.
    </p>

    <div class="pl-filters" role="group" aria-label="Filter by concept">
      <button class="pl-chip is-on" data-filter="*" aria-pressed="true">
        All <span class="pl-chip__n">{rows.length}</span>
      </button>
      {counts.map((c) => (
        <button class="pl-chip" data-filter={c.tag} aria-pressed="false" style={`--tag:${hueOf(c.tag)};`}>
          {c.tag} <span class="pl-chip__n">{c.n}</span>
        </button>
      ))}
    </div>

    <ul class="pl">
      {rows.map((r, i) => (
        <li class="pl__item" data-tag={r.tag}>
          <button
            class="mq-check"
            data-progress-kind="problem"
            data-progress-id={r.slug}
            aria-pressed="false"
            aria-label={`Mark "${r.title}" as solved`}
          >✓</button>
          <details class="pl__d">
            <summary class="pl__sum">
              <span class="pl__num mono">{pad(i + 1)}</span>
              <span class="pl__title">{r.title}</span>
              <span class="pl__tag mono" style={`--tag:${hueOf(r.tag)};`}>{r.tag}</span>
              <span class="pl__spacer"></span>
              <span class="pl__meta">
                <span class="pl__diff mono" style={`color:${diffColor[r.difficulty]};`}>{r.difficulty}</span>
                {r.video && <span class="pl__has mono" title="Has a walkthrough video">▶</span>}
              </span>
            </summary>
            <div class={`pl__body${r.video ? '' : ' pl__body--novideo'}`}>
              {/* Row 1 spans both columns: identify, then act. Row 2 is
                  video left, notes right, tops aligned. */}
              <div class="pl__actions">
                  {/* The id sits with the action, not in the list: browsing it
                      is near-redundant with the title, but submitting needs it
                      verbatim. select-all so one click grabs the whole thing. */}
                  <code class="pl__id mono" title="Kattis problem id">{r.kid}</code>
                  <a class="ps-btn ps-btn--sm pl__go" href={r.url} target="_blank" rel="noopener">
                    Solve on {r.judge} →
                  </a>
              </div>

              {r.video && (
                <a class="pl__video" href={`https://www.youtube.com/watch?v=${r.video.id}`} target="_blank" rel="noopener">
                  <span class="pl__video__frame">
                    <img src={`https://i.ytimg.com/vi/${r.video.id}/hqdefault.jpg`} alt="" loading="lazy" />
                    <span class="pl__video__play" aria-hidden="true">▶</span>
                    <span class="pl__video__dur mono" aria-hidden="true">{r.video.dur}</span>
                  </span>
                  <span class="pl__video__meta">
                    <span class="pl__video__label mono">Watch</span>
                    <span class="pl__video__title">{r.video.title}</span>
                  </span>
                </a>
              )}

              <div class="pl__notes">
                {r.Body ? <r.Body /> : <p class="pl__empty">No notes yet.</p>}
              </div>
            </div>
          </details>
        </li>
      ))}
    </ul>
  </main>

  <script>
    import { initProgress } from '../../scripts/progress.ts';
    initProgress();

    const chips = document.querySelectorAll<HTMLButtonElement>('.pl-chip');
    const items = document.querySelectorAll<HTMLElement>('.pl__item');
    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const want = chip.dataset.filter!;
        chips.forEach((c) => {
          const on = c === chip;
          c.classList.toggle('is-on', on);
          c.setAttribute('aria-pressed', String(on));
        });
        items.forEach((li) => {
          li.hidden = want !== '*' && li.dataset.tag !== want;
        });
      });
    });
  </script>
</Base>

<style>
  .pl-filters { display: flex; flex-wrap: wrap; gap: var(--space-2); margin: var(--space-6) 0 var(--space-4); }
  .pl-chip {
    display: inline-flex; align-items: center; gap: var(--space-2);
    font-family: var(--font-label); font-size: var(--text-label);
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--line-strong); border-radius: var(--radius-pill);
    background: var(--surface); color: var(--ink); cursor: pointer;
  }
  .pl-chip::before {
    content: ''; width: 8px; height: 8px; border-radius: var(--radius-pill);
    background: var(--tag, var(--ink-muted));
  }
  .pl-chip__n { color: var(--ink-muted); }
  .pl-chip.is-on { background: var(--ink-strong); color: var(--paper); border-color: var(--ink-strong); }
  .pl-chip.is-on .pl-chip__n { color: var(--paper); }
  .pl-chip:focus-visible { outline: var(--border-thick) solid var(--focus-ring); outline-offset: 2px; }

  /* Full content width: the collapsed rows do not need it, but the expanded
     body does — notes and the video sit side by side there. */
  .pl { list-style: none; margin: 0; padding: 0;
        border: 1px solid var(--line); border-radius: var(--radius-lg); background: var(--surface); overflow: hidden; }
  .pl__item { display: grid; grid-template-columns: 1.75rem 1fr; gap: var(--space-3);
              align-items: start; padding: var(--space-3) var(--space-4); border-bottom: 1px solid var(--line); }
  .pl__item:last-child { border-bottom: 0; }
  .pl__item[hidden] { display: none; }

  .pl__d { min-width: 0; }
  /* Title and tag are bounded and sit together — they describe the same thing,
     so they should not drift apart as the container grows. The spacer takes
     the slack; difficulty and the video marker stay right-aligned as a column
     you scan vertically. */
  .pl__sum {
    display: grid;
    grid-template-columns: 1.75rem minmax(0, 24rem) max-content 1fr max-content;
    gap: var(--space-3); align-items: center;
    cursor: pointer; list-style: none;
  }
  .pl__meta { display: flex; align-items: center; gap: var(--space-3); }
  .pl__sum::-webkit-details-marker { display: none; }
  .pl__sum:focus-visible { outline: var(--border-thick) solid var(--focus-ring); outline-offset: 2px; border-radius: var(--radius-sm); }
  .pl__num { font-size: var(--text-label); color: var(--ink-muted); }
  .pl__title { color: var(--ink-strong); }
  .pl__tag {
    font-size: var(--text-label); color: var(--ink);
    padding: 2px var(--space-3); border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--tag) 18%, transparent);
    border: 1px solid color-mix(in srgb, var(--tag) 45%, transparent);
    white-space: nowrap;
  }
  .pl__diff { font-size: var(--text-label); }
  .pl__has { font-size: var(--text-label); color: var(--accent-text); }

  /* Action row spans both columns; below it the video sits left and the notes
     right, tops aligned. justify-content:start keeps the pair grouped rather
     than spread across the full row. */
  .pl__body {
    display: grid;
    grid-template-columns: 16rem minmax(0, var(--measure));
    justify-content: start;
    gap: var(--space-4) var(--space-5);
    align-items: start;
    padding: var(--space-4) 0 var(--space-4) 2.75rem;
  }
  .pl__body--novideo { grid-template-columns: minmax(0, var(--measure)); }
  .pl__actions { grid-column: 1 / -1; display: flex; align-items: center; gap: var(--space-3); flex-wrap: wrap; }
  .pl__notes { min-width: 0; font-size: var(--text-sm); color: var(--ink); }
  .pl__notes > :first-child { margin-top: 0; }
  .pl__notes > :last-child { margin-bottom: 0; }
  .pl__go { flex: none; }
  .pl__id {
    font-size: var(--text-label); color: var(--ink-strong);
    background: var(--paper-sunk); border: 1px solid var(--line-strong);
    border-radius: var(--radius-pill); padding: 4px var(--space-3);
    user-select: all; cursor: text;
  }
  .pl__empty { color: var(--ink-muted); margin: 0; }

  .pl__video { display: block; text-decoration: none;
               border: 1px solid var(--line); border-radius: var(--radius-md); overflow: hidden;
               background: var(--surface); transition: border-color var(--dur-fast) var(--ease-out); }
  .pl__video:hover { border-color: var(--accent); }
  .pl__video:focus-visible { outline: var(--border-thick) solid var(--focus-ring); outline-offset: 2px; }
  .pl__video__frame { display: block; position: relative; aspect-ratio: 16/9; background: var(--paper-sunk); }
  .pl__video img { display: block; width: 100%; height: 100%; object-fit: cover; }
  /* The affordances that say "video" rather than "picture": a play target over
     the poster and a runtime chip, the conventions every player uses. */
  .pl__video__play {
    position: absolute; inset: 0; margin: auto;
    width: 44px; height: 44px; border-radius: var(--radius-pill);
    display: grid; place-items: center;
    background: color-mix(in srgb, var(--ink-strong) 72%, transparent);
    color: #fff; font-size: 15px; padding-left: 3px;
  }
  .pl__video:hover .pl__video__play { background: var(--accent); }
  .pl__video__dur {
    position: absolute; right: 6px; bottom: 6px;
    padding: 1px 6px; border-radius: var(--radius-sm);
    font-size: var(--text-label); color: #fff;
    background: color-mix(in srgb, var(--ink-strong) 80%, transparent);
  }
  .pl__video__meta { display: block; padding: var(--space-2) var(--space-3); }
  .pl__video__label { display: block; font-size: var(--text-label); color: var(--accent-text); letter-spacing: var(--tracking-wide); }
  .pl__video__title { display: block; font-size: var(--text-sm); font-weight: var(--weight-semibold); color: var(--ink-strong); line-height: 1.25; }

  @media (max-width: 900px) {
    .pl__body,
    .pl__body--novideo { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 720px) {
    .pl__sum { grid-template-columns: 1.75rem minmax(0, 1fr) auto; row-gap: var(--space-2); }
    .pl__tag { grid-column: 2 / -1; justify-self: start; }
    .pl__body { padding-left: 0; }
  }
</style>
