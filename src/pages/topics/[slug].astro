---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { nextTopic, totalDuration, isOptional, type RoadmapTopic } from '../../lib/roadmap';

export async function getStaticPaths() {
  const topics = await getCollection('topics');
  const problems = await getCollection('problems');
  const roadmap: RoadmapTopic[] = topics.map((t) => ({
    slug: t.id, name: t.data.name, level: t.data.level, order: t.data.order,
  }));
  return topics.map((topic) => ({
    params: { slug: topic.id },
    props: {
      topic,
      problems: problems
        .filter((p) => p.data.topic.id === topic.id)
        .sort((a, b) => a.data.order - b.data.order),
      next: nextTopic(roadmap, topic.id),
    },
  }));
}

interface Props {
  topic: CollectionEntry<'topics'>;
  problems: CollectionEntry<'problems'>[];
  next: RoadmapTopic | null;
}
const { topic, problems, next } = Astro.props as Props;
const { Content, headings } = await render(topic);
const stroke = `var(--cat-${topic.data.color.slice(1)})`;
const optional = isOptional(topic.data);

// Videos live on the problem they teach; a topic only keeps the ones that
// teach a concept with no problem attached.
const conceptVideos = topic.data.videos;
const allVideos = [...problems.flatMap((p) => p.data.videos), ...conceptVideos];
const runtime = totalDuration(allVideos.map((v) => v.duration));

const rows = await Promise.all(
  problems.map(async (p) => ({
    slug: p.id,
    data: p.data,
    // The Kattis problem id is the last URL segment — exactly what kattis-cli
    // takes, and what the hero terminal submits.
    kid: p.data.url.replace(/\/+$/, '').split('/').pop(),
    Body: p.body && p.body.trim() ? (await render(p)).Content : null,
  })),
);

// Hue by position within this page's own tag list, so no two tags on a page
// ever share a colour.
const pageTags = [...new Set(rows.flatMap((r) => r.data.tags))];
const hueOf = (tag: string) => `var(--cat-${(pageTags.indexOf(tag) % 6) + 1})`;
const counts = pageTags.map((t) => ({ tag: t, n: rows.filter((r) => r.data.tags.includes(t)).length }));

const contents = [
  ...headings.filter((h) => h.depth === 2).map((h) => ({ id: h.slug, text: h.text })),
  ...(conceptVideos.length > 0 ? [{ id: 'concepts', text: 'Concept videos' }] : []),
  { id: 'problems', text: 'Problems' },
];

const diffColor: Record<string, string> = { easy: 'var(--success)', medium: 'var(--warning)', hard: 'var(--danger)' };
const pad = (n: number) => String(n).padStart(2, '0');
---
<Base title={`${topic.data.name} — MQ CP Club`} description={topic.data.blurb}>
  <Header />
  <main class="mq-page mq-page--tight">
    <a class="mono text-label text-ink-muted no-underline" href="/learn">← All topics</a>

    <div class="mq-topic__rule mt-5" style={`border-top:3px solid ${stroke};`}></div>
    <div class="mq-split mq-split--reading">
      <div>
        <div class="flex items-center gap-4 flex-wrap">
          <h1 class="ps-h1">{topic.data.name}</h1>
          {optional && <span class="ps-pill">optional</span>}
        </div>
        <div class="mono mq-topic__meta">
          {problems.length > 0 && <span>{problems.length} problems</span>}
          {allVideos.length > 0 && (
            <span>{allVideos.length} {allVideos.length === 1 ? 'video' : 'videos'}</span>
          )}
          {runtime && <span>{runtime}</span>}
        </div>
        {optional && (
          <p class="text-ink max-w-measure mt-3">
            Supplementary — not a step on the roadmap, and safe to skip entirely.
          </p>
        )}
        <div class="text-ink mt-3 max-w-measure"><Content /></div>
      </div>

      <aside class="mq-aside">
        {contents.length > 0 && (
          <nav class="mq-toc" aria-label="On this page">
            <div class="mq-toc__title">On this page</div>
            <ul class="mq-toc__list">
              {contents.map((c) => (
                <li><a class="mq-toc__link" href={`#${c.id}`}>{c.text}</a></li>
              ))}
            </ul>
          </nav>
        )}
        {problems.length > 0 && (
          <div class="mq-toc__stat">
            <span class="mono">Solved</span>
            <span
              class="mono mq-toc__count"
              data-progress-count="problem"
              data-progress-format="short"
              data-progress-ids={rows.map((r) => r.slug).join(',')}
            >0/{problems.length}</span>
          </div>
        )}
        {next && (
          <a class="mq-toc__next mono" href={`/topics/${next.slug}`}>Next: {next.name} →</a>
        )}
      </aside>
    </div>

    {conceptVideos.length > 0 && (
      <>
        <h2 id="concepts" class="ps-h3 mq-heading mq-heading--mt8">Concept videos</h2>
        <p class="text-ink max-w-measure mb-4">
          These teach an idea rather than a specific problem. Everything else is attached to the
          problem it walks through.
        </p>
        <ul class="mq-vgrid mq-grid-3" style={`--cols:${conceptVideos.length};`}>
          {conceptVideos.map((v) => (
            <li>
              <a class="mq-vcard" href={`https://www.youtube.com/watch?v=${v.youtubeId}`} target="_blank" rel="noopener">
                <span class="mq-vcard__frame">
                  <img src={`https://i.ytimg.com/vi/${v.youtubeId}/hqdefault.jpg`} alt="" loading="lazy" />
                  <span class="mq-vcard__play" aria-hidden="true">▶</span>
                  {v.duration && <span class="mq-vcard__dur mono" aria-hidden="true">{v.duration}</span>}
                </span>
                <span class="mq-vcard__meta">
                  <span class="mq-vcard__label mono">Watch</span>
                  <span class="mq-vcard__title">{v.title}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </>
    )}

    <h2 id="problems" class="ps-h3 mq-heading mq-heading--mt8">Problems</h2>
    {problems.length === 0 ? (
      <p class="text-ink max-w-measure">
        No problems for this topic yet — pick another from the
        <a class="mono text-accent-text no-underline" href="/learn"> roadmap</a>.
      </p>
    ) : (
      <>
        <p class="text-ink max-w-measure mb-4">
          Each row is one problem with its walkthrough and notes. Tick them off as you solve them —
          that is kept in this browser only.
          {topic.id !== 'getting-started' && (
            <>
              {' '}New to Kattis?{' '}
              <a class="text-accent-text" href="/topics/getting-started#your-first-submission">
                What happens when you submit →
              </a>
            </>
          )}
        </p>

        {counts.length > 1 && (
          <div class="mq-filters" role="group" aria-label="Filter by concept">
            <button class="mq-chip is-on" data-filter="*" aria-pressed="true">
              All <span class="mq-chip__n">{rows.length}</span>
            </button>
            {counts.map((c) => (
              <button class="mq-chip" data-filter={c.tag} aria-pressed="false" style={`--tag:${hueOf(c.tag)};`}>
                {c.tag} <span class="mq-chip__n">{c.n}</span>
              </button>
            ))}
          </div>
        )}

        <ul class="mq-plist">
          {rows.map((r, i) => (
            <li class="mq-prob" data-tags={r.data.tags.join('|')}>
              <button
                class="mq-check"
                data-progress-kind="problem"
                data-progress-id={r.slug}
                aria-pressed="false"
                aria-label={`Mark "${r.data.title}" as solved`}
              >✓</button>
              {/* Native details, and the checkbox above is a SIBLING: an
                  interactive control inside <summary> gets swallowed by the
                  disclosure toggle. */}
              <details class="mq-prob__d">
                <summary class="mq-prob__sum">
                  <span class="mq-prob__num mono">{pad(i + 1)}</span>
                  <span class="mq-prob__title">{r.data.title}</span>
                  {r.data.tags.map((t) => (
                    <span class="mq-prob__tag mono" style={`--tag:${hueOf(t)};`}>{t}</span>
                  ))}
                  <span class="mq-prob__spacer"></span>
                  <span class="mq-prob__meta">
                    <span class="mono" style={`color:${diffColor[r.data.difficulty]};`}>{r.data.difficulty}</span>
                    {r.data.videos.length > 0 && (
                      <span class="mq-prob__has mono" title="Has a walkthrough">▶</span>
                    )}
                  </span>
                </summary>

                <div class={`mq-prob__body${r.data.videos.length ? '' : ' mq-prob__body--novideo'}`}>
                  <div class="mq-prob__actions">
                    <code class="mq-prob__id mono" title="Kattis problem id">{r.kid}</code>
                    <a class="ps-btn ps-btn--sm" href={r.data.url} target="_blank" rel="noopener">
                      Solve on {r.data.judge} →
                    </a>
                  </div>

                  {r.data.videos.map((v) => (
                    <a class="mq-vcard" href={`https://www.youtube.com/watch?v=${v.youtubeId}`} target="_blank" rel="noopener">
                      <span class="mq-vcard__frame">
                        <img src={`https://i.ytimg.com/vi/${v.youtubeId}/hqdefault.jpg`} alt="" loading="lazy" />
                        <span class="mq-vcard__play" aria-hidden="true">▶</span>
                        {v.duration && <span class="mq-vcard__dur mono" aria-hidden="true">{v.duration}</span>}
                      </span>
                      <span class="mq-vcard__meta">
                        <span class="mq-vcard__label mono">Watch</span>
                        <span class="mq-vcard__title">{v.title}</span>
                      </span>
                    </a>
                  ))}

                  <div class="mq-prob__notes">
                    {r.Body ? <r.Body /> : <p class="mq-prob__empty">No notes yet.</p>}
                  </div>
                </div>
              </details>
            </li>
          ))}
        </ul>
      </>
    )}

    {next ? (
      <a class="mq-next" href={`/topics/${next.slug}`}>
        <span class="mono text-label text-ink-muted">Next in the roadmap</span>
        <span class="mq-next__name">{next.name} →</span>
      </a>
    ) : (
      <a class="mq-next" href="/learn">
        <span class="mono text-label text-ink-muted">
          {optional ? 'Back to the main path' : 'End of the roadmap'}
        </span>
        <span class="mq-next__name">All topics →</span>
      </a>
    )}
  </main>

  <script>
    import { initProgress } from '../../scripts/progress.ts';
    initProgress();

    const chips = document.querySelectorAll<HTMLButtonElement>('.mq-chip');
    const items = document.querySelectorAll<HTMLElement>('.mq-prob');
    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const want = chip.dataset.filter!;
        chips.forEach((c) => {
          const on = c === chip;
          c.classList.toggle('is-on', on);
          c.setAttribute('aria-pressed', String(on));
        });
        items.forEach((li) => {
          li.hidden = want !== '*' && !(li.dataset.tags ?? '').split('|').includes(want);
        });
      });
    });
  </script>
</Base>
