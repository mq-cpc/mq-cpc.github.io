---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const topics = await getCollection('topics');
  const problems = await getCollection('problems');
  return topics.map((topic) => ({
    params: { slug: topic.id },
    props: {
      topic,
      problems: problems
        .filter((p) => p.data.topic.id === topic.id)
        .sort((a, b) => a.data.order - b.data.order),
    },
  }));
}

interface Props { topic: CollectionEntry<'topics'>; problems: CollectionEntry<'problems'>[] }
const { topic, problems } = Astro.props as Props;
const { Content } = await render(topic);
const stroke = `var(--cat-${topic.data.color.slice(1)})`;
const diffColor: Record<string, string> = { easy: 'var(--success)', medium: 'var(--warning)', hard: 'var(--danger)' };
---
<Base title={`${topic.data.name} — MQ CP Club`}>
  <Header />
  <main class="mq-page mq-page--tight">
    <a class="mono text-[13px] text-ink-muted no-underline" href="/learn">← Learn / Roadmap</a>
    <div class="pl-4 mt-4" style={`border-left:4px solid ${stroke};`}>
      <h1 class="ps-h1">{topic.data.name}</h1>
      <div class="text-ink mt-3"><Content /></div>
    </div>

    {topic.data.videos.length > 0 && (
      <>
        <h2 class="ps-h3 mq-heading mq-heading--mt7">Video Tutorials</h2>
        <div class="flex gap-4 overflow-x-auto pt-[2px] px-[2px] pb-4 [scroll-snap-type:x_proximity]">
          {topic.data.videos.map((v) => (
            <div class="video-card flex-[0_0_clamp(240px,58vw,300px)] [scroll-snap-align:start] cursor-pointer bg-surface border border-line rounded-lg overflow-hidden" data-yt={v.youtubeId}>
              <div class="aspect-[16/9] relative bg-paper-sunk" data-yt-frame>
                <img src={`https://i.ytimg.com/vi/${v.youtubeId}/hqdefault.jpg`} alt={v.title} loading="lazy" class="w-full h-full object-cover block" />
                <span class="absolute inset-0 grid place-items-center pointer-events-none">
                  <span class="w-[46px] h-[46px] rounded-[999px] grid place-items-center border border-line-strong" style="background:color-mix(in srgb, var(--surface) 80%, transparent);"><span class="text-accent-text text-[15px] ml-[2px]">▶</span></span>
                </span>
                {v.duration && <span class="mono absolute bottom-[6px] right-[6px] text-paper text-[11px] py-[1px] px-[6px] rounded-sm" style="background:color-mix(in srgb, var(--ink-strong) 76%, transparent);">{v.duration}</span>}
              </div>
              <div class="py-3 px-4">
                <div class="text-sm font-semibold text-ink-strong leading-[1.25]">{v.title}</div>
                <div class="mono text-[11px] text-ink-muted mt-[4px]">YouTube{v.channel ? ` · ${v.channel}` : ''}</div>
              </div>
            </div>
          ))}
        </div>
        <script>
          document.querySelectorAll('.video-card').forEach((card) => {
            card.addEventListener('click', () => {
              const id = card.getAttribute('data-yt');
              const frame = card.querySelector('[data-yt-frame]');
              if (!id || !frame || frame.dataset.playing) return;
              frame.dataset.playing = '1';
              frame.innerHTML =
                '<iframe style="position:absolute;inset:0;width:100%;height:100%;border:0;display:block;" src="https://www.youtube-nocookie.com/embed/' +
                id + '?autoplay=1" title="video" allow="autoplay; fullscreen" allowfullscreen></iframe>';
            });
          });
        </script>
      </>
    )}

    <h2 class="ps-h3 mq-heading mq-heading--mt7">Problem set</h2>
    <div class="border border-line rounded-lg overflow-hidden bg-surface">
      <div class="mono grid grid-cols-[36px_1fr_96px_168px_132px] gap-3 py-[11px] px-4 bg-paper-sunk border-b border-line text-[11px] text-ink-muted uppercase">
        <span>#</span><span>Problem</span><span>Difficulty</span><span>Links</span><span>Status</span>
      </div>
      {problems.map((p, i) => (
        <div class="grid grid-cols-[36px_1fr_96px_168px_132px] gap-3 items-center py-[12px] px-4 border-b border-line" data-problem-id={p.id}>
          <span class="mono text-ink-muted">{i + 1}</span>
          <span class="text-ink-strong">{p.data.title}</span>
          <span class="ps-pill" style={`color:${diffColor[p.data.difficulty]};border-color:transparent;`}>{p.data.difficulty}</span>
          <span class="mono text-[12px] flex gap-[12px]">
            <a href={p.data.url} target="_blank" rel="noopener" class="text-accent-text">{p.data.judge} →</a>
          </span>
          <span class="mono text-[12px] text-ink-muted" data-status-slot>— sign in —</span>
        </div>
      ))}
    </div>
  </main>
</Base>
