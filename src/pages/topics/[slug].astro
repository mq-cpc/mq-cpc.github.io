---
import { withBase } from '../../lib/base';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { marked } from 'marked';
import { nextTopic, totalDuration, isOptional, type RoadmapTopic } from '../../lib/roadmap';
import { sectionsFor, groupProblems } from '../../lib/topic-sections';

export async function getStaticPaths() {
  const topics = await getCollection('topics');
  const problems = await getCollection('problems');
  const roadmap: RoadmapTopic[] = topics.map((t) => ({
    slug: t.id, name: t.data.name, level: t.data.level, order: t.data.order,
  }));
  return topics.map((topic) => ({
    params: { slug: topic.id },
    props: {
      topic,
      problems: problems
        .filter((p) => p.data.topic.id === topic.id)
        .sort((a, b) => a.data.order - b.data.order),
      next: nextTopic(roadmap, topic.id),
    },
  }));
}

interface Props {
  topic: CollectionEntry<'topics'>;
  problems: CollectionEntry<'problems'>[];
  next: RoadmapTopic | null;
}
const { topic, problems, next } = Astro.props as Props;
const { Content, headings } = await render(topic);
const stroke = `var(--cat-${topic.data.color.slice(1)})`;
const optional = isOptional(topic.data);

// Videos live on the problem they teach; a topic only keeps the ones that
// teach a concept with no problem attached.
const conceptVideos = topic.data.videos;
const allVideos = [...problems.flatMap((p) => p.data.videos), ...conceptVideos];
const runtime = totalDuration(allVideos.map((v) => v.duration));

const rows = await Promise.all(
  problems.map(async (p) => ({
    id: p.id,
    data: p.data,
    section: p.data.section,
    hasVideo: p.data.videos.length > 0,
    // Explicit when the judge's URL does not carry the id (CodingBat's
    // /prob/p145416 is not the problem name), otherwise the last URL segment,
    // which is what Kattis uses and what kattis-cli takes.
    kid: p.data.problemId ?? p.data.url.replace(/\/+$/, '').split('/').pop(),
    Body: p.body && p.body.trim() ? (await render(p)).Content : null,
    // Markdown, same treatment as a section intro.
    hints: p.data.hints.map((h) => marked.parse(h, { async: false }) as string),
  })),
);

// Hue by position within this page's own tag list, so no two tags on a page
// ever share a colour.
const pageTags = [...new Set(rows.flatMap((r) => r.data.tags))];
const hueOf = (tag: string) => `var(--cat-${(pageTags.indexOf(tag) % 6) + 1})`;
const counts = pageTags.map((t) => ({ tag: t, n: rows.filter((r) => r.data.tags.includes(t)).length }));

// Sections are authored per topic; a topic that declares none gets the default
// Video Tutorials / Additional Problems split. Empty ones never render, so a
// topic where every problem has a walkthrough shows one heading, not two.
const groups = groupProblems(sectionsFor(topic.data.sections), rows, topic.id);
const intros = new Map(
  groups
    .filter((g) => g.section.intro)
    .map((g) => [g.section.id, marked.parse(g.section.intro!, { async: false }) as string]),
);

const contents = [
  ...headings.filter((h) => h.depth === 2).map((h) => ({ id: h.slug, text: h.text })),
  ...(conceptVideos.length > 0 ? [{ id: 'concepts', text: 'Concept videos' }] : []),
  ...(groups.length > 0
    ? groups.map((g) => ({ id: g.section.id, text: g.section.title }))
    : [{ id: 'problems', text: 'Problems' }]),
];

const diffColor: Record<string, string> = { easy: 'var(--success)', medium: 'var(--warning)', hard: 'var(--danger)' };
const pad = (n: number) => String(n).padStart(2, '0');
---
<Base title={`${topic.data.name} — MQ CP Club`} description={topic.data.blurb}>
  <Header />
  <main class="mq-page mq-page--tight">
    <a class="mono text-label text-ink-muted no-underline" href={withBase("/learn")}>← All topics</a>

    <div class="mq-topic__rule mt-5" style={`border-top:3px solid ${stroke};`}></div>
    <div class="mq-split mq-split--reading">
      <div>
        <div class="flex items-center gap-4 flex-wrap">
          <h1 class="ps-h1">{topic.data.name}</h1>
          {optional && <span class="ps-pill">optional</span>}
        </div>
        <div class="mono mq-topic__meta">
          {problems.length > 0 && <span>{problems.length} problems</span>}
          {allVideos.length > 0 && (
            <span>{allVideos.length} {allVideos.length === 1 ? 'video' : 'videos'}</span>
          )}
          {runtime && <span>{runtime}</span>}
        </div>
        {optional && (
          <p class="text-ink max-w-measure mt-3">
            Supplementary — not a step on the roadmap, and safe to skip entirely.
          </p>
        )}
        <div class="text-ink mt-3 max-w-measure"><Content /></div>
      </div>

      <aside class="mq-aside">
        {contents.length > 0 && (
          <nav class="mq-toc" aria-label="On this page">
            <div class="mq-toc__title">On this page</div>
            <ul class="mq-toc__list">
              {contents.map((c) => (
                <li><a class="mq-toc__link" href={`#${c.id}`}>{c.text}</a></li>
              ))}
            </ul>
          </nav>
        )}
        {problems.length > 0 && (
          <div class="mq-toc__stat">
            <span class="mono">Solved</span>
            <span
              class="mono mq-toc__count"
              data-progress-count="problem"
              data-progress-format="short"
              data-progress-ids={rows.map((r) => r.id).join(',')}
            >0/{problems.length}</span>
          </div>
        )}
        {next && (
          <a class="mq-toc__next mono" href={withBase(`/topics/${next.slug}`)}>Next: {next.name} →</a>
        )}
      </aside>
    </div>

    {conceptVideos.length > 0 && (
      <>
        <h2 id="concepts" class="ps-h3 mq-heading mq-heading--mt8">Concept videos</h2>
        <p class="text-ink max-w-measure mb-4">
          These teach an idea rather than a specific problem. Everything else is attached to the
          problem it walks through.
        </p>
        <ul class="mq-vgrid mq-grid-3" style={`--cols:${conceptVideos.length};`}>
          {conceptVideos.map((v) => (
            <li>
              <a class="mq-vcard" href={`https://www.youtube.com/watch?v=${v.youtubeId}`} target="_blank" rel="noopener">
                <span class="mq-vcard__frame">
                  <img src={`https://i.ytimg.com/vi/${v.youtubeId}/hqdefault.jpg`} alt="" loading="lazy" />
                  <span class="mq-vcard__play" aria-hidden="true">▶</span>
                  {v.duration && <span class="mq-vcard__dur mono" aria-hidden="true">{v.duration}</span>}
                </span>
                <span class="mq-vcard__meta">
                  <span class="mq-vcard__label mono">Watch</span>
                  <span class="mq-vcard__title">{v.title}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </>
    )}

    {groups.length === 0 ? (
      <>
        <h2 id="problems" class="ps-h3 mq-heading mq-heading--mt8">Problems</h2>
        <p class="text-ink max-w-measure">
          No problems for this topic yet — pick another from the
          <a class="mono text-accent-text no-underline" href={withBase("/learn")}> roadmap</a>.
        </p>
      </>
    ) : (
      <>
        {/* One bar for the whole page, and deliberately outside the sections:
            filtering to a tag that only occurs in a later section hides the
            earlier ones, and chips that hid themselves could not be undone. */}
        {counts.length > 1 && (
          <div class="mq-filters mt-7" role="group" aria-label="Filter by concept">
            <button class="mq-chip is-on" data-filter="*" aria-pressed="true">
              All <span class="mq-chip__n">{rows.length}</span>
            </button>
            {counts.map((c) => (
              <button class="mq-chip" data-filter={c.tag} aria-pressed="false" style={`--tag:${hueOf(c.tag)};`}>
                {c.tag} <span class="mq-chip__n">{c.n}</span>
              </button>
            ))}
          </div>
        )}

        {groups.map((g) => (
        <section class="mq-psection">
        <h2 id={g.section.id} class="ps-h3 mq-heading mq-heading--mt8">{g.section.title}</h2>
        {intros.has(g.section.id) && <div class="mq-sec__intro" set:html={intros.get(g.section.id)} />}
        <ul class="mq-plist">
          {g.items.map((r, i) => (
            <li class="mq-prob" data-tags={r.data.tags.join('|')}>
              <button
                class="mq-check"
                data-progress-kind="problem"
                data-progress-id={r.id}
                aria-pressed="false"
                aria-label={`Mark "${r.data.title}" as solved`}
              >✓</button>
              {/* Native details, and the checkbox above is a SIBLING: an
                  interactive control inside <summary> gets swallowed by the
                  disclosure toggle. */}
              <details class="mq-prob__d">
                <summary class="mq-prob__sum">
                  <span class="mq-prob__num mono">{pad(i + 1)}</span>
                  <span class="mq-prob__title">{r.data.title}</span>
                  {/* One wrapper, always present: the summary is a five-track
                      grid, so tags must be a single item. Loose spans made the
                      item count follow the tag count — no tags shifted
                      difficulty into the tag column, two tags wrapped the row. */}
                  <span class="mq-prob__tags">
                    {r.data.tags.map((t) => (
                      <span class="mq-prob__tag mono" style={`--tag:${hueOf(t)};`}>{t}</span>
                    ))}
                  </span>
                  <span class="mq-prob__spacer"></span>
                  <span class="mq-prob__meta">
                    <span class="mono" style={`color:${diffColor[r.data.difficulty]};`}>{r.data.difficulty}</span>
                    {/* Always rendered, hidden rather than dropped when there
                        is no walkthrough: the glyph keeps its width, so the
                        difficulty labels line up down the whole page. */}
                    <span
                      class={`mq-prob__has mono${r.hasVideo ? '' : ' mq-prob__has--none'}`}
                      title={r.hasVideo ? 'Has a walkthrough' : undefined}
                    >▶</span>
                  </span>
                </summary>

                <div class={`mq-prob__body${r.data.videos.length ? '' : ' mq-prob__body--novideo'}`}>
                  <div class="mq-prob__actions">
                    <code class="mq-prob__id mono" title={`${r.data.judge} problem id`}>{r.kid}</code>
                    <a class="ps-btn ps-btn--sm" href={r.data.url} target="_blank" rel="noopener">
                      Solve on {r.data.judge} →
                    </a>
                  </div>

                  {/* Between the judge link and the walkthrough on purpose:
                      reading down this panel is climbing the spoiler ladder —
                      go solve it, then a nudge, then the whole answer. Native
                      <details> per hint, so with JavaScript off all of them
                      open independently; the script below only gates them. */}
                  {r.hints.length > 0 && (
                    <div class="mq-hints" data-hints>
                      {r.hints.map((html, k) => (
                        <details class="mq-hint">
                          <summary class="mq-hint__toggle mono">
                            <span class="mq-hint__shut">Show hint {k + 1}</span>
                            <span class="mq-hint__open">Hint {k + 1}</span>
                          </summary>
                          <div class="mq-hint__body" set:html={html} />
                        </details>
                      ))}
                      <p class="mq-hint__rest mono" data-hint-rest hidden></p>
                    </div>
                  )}

                  {r.data.videos.map((v) => (
                    <a class="mq-vcard" href={`https://www.youtube.com/watch?v=${v.youtubeId}`} target="_blank" rel="noopener">
                      <span class="mq-vcard__frame">
                        <img src={`https://i.ytimg.com/vi/${v.youtubeId}/hqdefault.jpg`} alt="" loading="lazy" />
                        <span class="mq-vcard__play" aria-hidden="true">▶</span>
                        {v.duration && <span class="mq-vcard__dur mono" aria-hidden="true">{v.duration}</span>}
                      </span>
                      <span class="mq-vcard__meta">
                        <span class="mq-vcard__label mono">Watch</span>
                        <span class="mq-vcard__title">{v.title}</span>
                      </span>
                    </a>
                  ))}

                  {/* No notes is not worth saying — the block is simply absent. */}
                  {r.Body && (
                    <div class="mq-prob__notes"><r.Body /></div>
                  )}
                </div>
              </details>
            </li>
          ))}
        </ul>
        </section>
        ))}
      </>
    )}

    {next ? (
      <a class="mq-next" href={withBase(`/topics/${next.slug}`)}>
        <span class="mono text-label text-ink-muted">Next in the roadmap</span>
        <span class="mq-next__name">{next.name} →</span>
      </a>
    ) : (
      <a class="mq-next" href={withBase("/learn")}>
        <span class="mono text-label text-ink-muted">
          {optional ? 'Back to the main path' : 'End of the roadmap'}
        </span>
        <span class="mq-next__name">All topics →</span>
      </a>
    )}
  </main>

  <script>
    import { initProgress } from '../../scripts/progress.ts';
    initProgress();

    // Hint gate. The page ships every hint open-able; this narrows it to one at
    // a time, so the escalation the author wrote is the escalation you get.
    // Without this script all hints stay independently available — a worse
    // experience, never a broken one.
    document.querySelectorAll<HTMLElement>('[data-hints]').forEach((box) => {
      const hints = [...box.querySelectorAll<HTMLDetailsElement>('.mq-hint')];
      const rest = box.querySelector<HTMLElement>('[data-hint-rest]');
      if (hints.length < 2 || !rest) return;

      // High-water mark, never recomputed downwards: collapsing a hint you have
      // already read must not snatch back the ones it unlocked.
      let reached = 0;
      const gate = () => {
        let frontier = 0;
        while (frontier < hints.length && hints[frontier].open) frontier++;
        reached = Math.max(reached, frontier);
        hints.forEach((h, i) => { h.hidden = i > reached; });
        const locked = hints.length - Math.min(reached + 1, hints.length);
        rest.hidden = locked === 0;
        rest.textContent = locked === 1 ? '1 more hint after this' : `${locked} more hints after this`;
      };

      box.dataset.gate = 'on';
      hints.forEach((h) => h.addEventListener('toggle', gate));
      gate();
    });

    const chips = document.querySelectorAll<HTMLButtonElement>('.mq-chip');
    const items = document.querySelectorAll<HTMLElement>('.mq-prob');
    const sections = document.querySelectorAll<HTMLElement>('.mq-psection');
    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const want = chip.dataset.filter!;
        chips.forEach((c) => {
          const on = c === chip;
          c.classList.toggle('is-on', on);
          c.setAttribute('aria-pressed', String(on));
        });
        items.forEach((li) => {
          li.hidden = want !== '*' && !(li.dataset.tags ?? '').split('|').includes(want);
        });
        // A section whose problems all filtered out takes its heading and
        // intro with it, rather than standing there introducing nothing.
        sections.forEach((s) => {
          s.hidden = [...s.querySelectorAll<HTMLElement>('.mq-prob')].every((li) => li.hidden);
        });
      });
    });
  </script>
</Base>
