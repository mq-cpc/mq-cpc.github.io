---
// src/pages/index.astro
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import EventCard from '../components/EventCard.astro';
import { getCollection } from 'astro:content';

// The kattis-cli "Accepted" banner, reproduced for the hero terminal.
// The emoji celebration lines are verbatim (first line left-aligned); the
// problem-name line is centred over the result table's width.
const kattisTable = [
  '┌────────────┬────────────┬───────────┬──────────────┬─────────────┬──────────┐',
  '│ Problem ID │ Difficulty │ CPU Limit │ Memory Limit │ Submissions │ Accepted │',
  '├────────────┼────────────┼───────────┼──────────────┼─────────────┼──────────┤',
  '│    cold    │    1.3     │           │     None     │      1      │    1     │',
  '└────────────┴────────────┴───────────┴──────────────┴─────────────┴──────────┘',
];
const centreOnTable = (s) => ' '.repeat(Math.max(0, Math.round((kattisTable[0].length - s.length) / 2))) + s;
// Rendered as two separate <pre> blocks: the emoji/title lines want breathing
// room, the table wants flush rows (line-height 1) so its borders connect. Both
// use a system monospace whose box-drawing glyphs share the ASCII cell width —
// the terminal's JetBrains Mono webfont falls back for box-drawing, which was
// drifting the columns.
const kattisTitle = [
  '🎉 Congratulations — Accepted! 🎉',
  '                             👍🎆🔥🎈🎈 YAY!! KEEP GOING... 🎈🎈👍🎆🔥',
  centreOnTable('Cold-puter Science'),
].join('\n');
const kattisTableText = kattisTable.join('\n');

const now = Date.now();
const upcoming = (await getCollection('events'))
  .filter((e) => e.data.date.getTime() >= now)
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime())
  .slice(0, 3);
---
<Base title="MQ Competitive Programming Club">
  <Header />
  <main class="mq-page mq-page--tight">

    <div class="mb-5">
      <span class="ps-pill ps-pill--accent"><span class="ps-pill__dot"></span>ICPC PREP · ALL LEVELS WELCOME</span>
    </div>

    <section class="mq-hero-split">
      <div class="flex flex-col gap-5">
        <h1 class="font-display font-medium text-[clamp(34px,4.4vw,54px)] leading-[1.04] tracking-[-0.02em] text-ink-strong m-0">
          Solve hard problems<br /><span class="text-accent-text">together.</span>
        </h1>
        <p class="text-md max-w-[46ch] text-ink m-0 leading-normal">
          A student-run club for ICPC prep and general coding practice. 
          Join us for regular meetups to discuss and train problem-solving skills. 


        </p>
        {/* Sign-in with GitHub is hidden until auth is supported — keep the markup for later.
        <div class="flex flex-wrap gap-3">
          <button class="ps-btn ps-btn--primary" disabled title="Coming soon" style="min-height:42px;padding:0 var(--space-5);font-size:var(--text-base);">Sign in with GitHub</button>
        </div>
        */}
        <div class="mono text-[12px] text-ink-muted flex gap-3 flex-wrap items-center">
          <span>127 members</span><span class="text-line-strong">·</span><span>all levels welcome</span><span class="text-line-strong">·</span><span class="text-accent-text">running since 2021</span>
        </div>
      </div>

      <div class="mq-hero-panel">
        <div class="flex items-center gap-[7px] py-[11px] px-[15px] bg-paper-sunk border-b border-line">
          <span class="w-[11px] h-[11px] rounded-pill bg-danger"></span>
          <span class="w-[11px] h-[11px] rounded-pill bg-cat-3"></span>
          <span class="w-[11px] h-[11px] rounded-pill bg-success"></span>
          <span class="mono ml-[10px] text-[12px] text-ink-muted">me@macquarie: ~/mqcpc/kattis</span>
        </div>
        <div class="mono py-[16px] px-[20px] text-[13px] leading-[1.9] text-ink">
          <div><span style="color:var(--success);">$</span> cd ~/mqcpc/kattis/cold</div>
          <div><span style="color:var(--success);">$</span> javac Main.java</div>
          <div><span style="color:var(--success);">$</span> java Main &lt; in.txt</div>
          <div class="text-ink-muted">1</div>
          <div><span style="color:var(--success);">$</span> kattis submit -p cold Main.java</div>
          <pre style="margin:var(--space-2) 0 0;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px;line-height:1.6;overflow-x:auto;color:var(--ink);">{kattisTitle}</pre>
          <pre style="margin:0;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px;line-height:1;overflow-x:auto;color:var(--ink);">{kattisTableText}</pre>
          <div><span style="color:var(--success);">$</span> <span style="display:inline-block;width:9px;height:16px;background:var(--accent);vertical-align:-3px;animation:mq-blink 1.1s steps(1) infinite;"></span></div>
        </div>
      </div>
    </section>

    <section class="mt-8">
      <h2 class="ps-h2 mq-heading mq-heading--mb4">Upcoming Events</h2>
      <div class="mq-grid-3">
        {upcoming.map((e) => (
          <EventCard title={e.data.title} date={e.data.date} location={e.data.location} tag={e.data.tag} />
        ))}
      </div>
    </section>

    <section class="mt-8">
      <h2 class="ps-h2 mq-heading mq-heading--mb4">Explore the club</h2>
      <div class="mq-grid-3">
        <a class="ps-card ps-card--c6" href="/learn">
          <span class="mono text-[22px]">↳</span>
          <div class="ps-card__title">Topic Roadmap</div>
          <div class="ps-card__body">12 ordered topics from two-pointers to flows. Track what you've solved.</div>
          <span class="mono mq-link mq-link--card">open learn →</span>
        </a>
        <a class="ps-card ps-card--c4" href="/resources">
          <span class="mono text-[22px]">{'{ }'}</span>
          <div class="ps-card__title">Team Reference</div>
          <div class="ps-card__body">A printable algorithm library: graphs, math, strings, geometry — copy-paste ready.</div>
          <span class="mono mq-link mq-link--card">open resources →</span>
        </a>
        <a class="ps-card ps-card--c2" href="/events">
          <span class="mono text-[22px]">▟</span>
          <div class="ps-card__title">Events</div>
          <div class="ps-card__body">Weekly practice, workshops, and contests — see what's coming up.</div>
          <span class="mono mq-link mq-link--card">open events →</span>
        </a>
      </div>
    </section>
  </main>
</Base>

<style>
  .mq-hero-split {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: var(--space-7);
    align-items: center;
  }
  @media (max-width: 860px) {
    .mq-hero-split { grid-template-columns: 1fr; }
  }

  .mq-hero-panel {
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
  }
</style>
