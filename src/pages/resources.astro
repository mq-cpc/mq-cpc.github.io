---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import { getCollection, render } from 'astro:content';

const linkGroups = (await getCollection('resources')).sort((a, b) => a.data.order - b.data.order);
const snippets = (await getCollection('reference')).sort((a, b) => a.data.order - b.data.order);
const byCategory = new Map<string, typeof snippets>();
for (const s of snippets) {
  const arr = byCategory.get(s.data.category) ?? [];
  arr.push(s);
  byCategory.set(s.data.category, arr);
}
const rendered = await Promise.all(snippets.map(async (s) => ({ slug: s.id, Content: (await render(s)).Content })));
const contentBySlug = new Map(rendered.map((r) => [r.slug, r.Content]));
---
<Base title="Resources — MQ CP Club">
  <Header />
  <main class="mq-page">
    <div class="mono mq-eyebrow">// RESOURCES</div>
    <h1 class="ps-h1 mq-h1-gap">Resources &amp; team reference</h1>

    <h2 class="ps-h2 mq-heading mq-heading--mt6">Curated links</h2>
    <div class="mq-grid-2">
      {linkGroups.map((g, i) => (
        <div class={`ps-card ps-card--c${(i % 6) + 1}`}>
          <div class="ps-card__title">{g.data.category}</div>
          {g.data.links.map((l) => (
            <a href={l.url} target="_blank" rel="noopener" class="mono mq-link--13 block">{l.label} →</a>
          ))}
        </div>
      ))}
    </div>

    <div class="mq-heading--mt7 flex items-baseline justify-between">
      <h2 class="ps-h2 mq-heading">Team reference notebook</h2>
      <button class="ps-btn ps-btn--sm" onclick="window.print()">⎙ Print / PDF</button>
    </div>
    {[...byCategory.entries()].map(([cat, items]) => (
      <section class="mb-6">
        <div class="mono text-label text-ink-muted uppercase mb-3">{cat}</div>
        {items.map((s) => {
          const C = contentBySlug.get(s.id)!;
          return (
            <div class="mb-4">
              <div class="mono text-label text-ink-strong mb-[6px]">{s.data.title} · {s.data.category}</div>
              <div class="mqcp-code"><C /></div>
            </div>
          );
        })}
      </section>
    ))}
  </main>
</Base>
